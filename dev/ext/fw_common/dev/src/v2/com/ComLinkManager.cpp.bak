// -- Behaviour

QStringList ComLinkManager::comPortList() const
{
    return m_comPortList;
}

bool ComLinkManager::startTcpServer(quint16 p_port)
{
    bool bRet = true;
    m_pComLinkTcpServer = new ComLinkTcpServer(m_pIntComMsg);
    m_pComLinkTcpServer->setFuncGeneral(m_pIntComMsg->getFuncGeneralParam());
    bRet = m_pComLinkTcpServer->startServer(p_port);
    addLink(m_pComLinkTcpServer);
    m_pComLinkTcpServer->startConnection();

    return bRet;
}

void ComLinkManager::stopTcpServer()
{
    if( nullptr != m_pComLinkTcpServer ) {
        m_pComLinkTcpServer->stopServer();
        deleteLink(m_pComLinkTcpServer);
    }
}

bool ComLinkManager::startUdpServer()
{
    bool bRet = true;
    m_pUdpServer = new ComLinkUdpServer();
    m_pUdpServer->startServer();
    return bRet;
}

void ComLinkManager::stopUdpServer()
{
    //
}

void ComLinkManager::startDiscover()
{
    // delete old link
    for(auto i : qAsConst(m_lDiscoverLinkTcp) ) {
        if( i->hasMappedDevice() ) {
            //m_pIntComMsg->getDeviceManager()->removeDevice(i->getMappedDevice());   ///< will delete the link // #PATCH SHOULD NOT BE COMMENTED #BUG
        } else {
            deleteLink(i);
        }
    }
    m_lDiscoverLinkTcp.clear();

    // make new links
    for(int i=0; i<1; i++) {
        {
            // External socket (Device)
            ComLinkTcpCli* pCli = new ComLinkTcpCli(m_pIntComMsg);
            ComLinkUdpCli* pUdp = new ComLinkUdpCli(m_pIntComMsg);
            ComLinkTcpConfig conf;
            ComLinkUdpConfig udpConf;
            conf.setHostAddress(QString("%1%2").arg(m_tcpDiscoverIpBase).arg(50+i));    // 192.168.0.44 for tests
            conf.setPortNumber(ComLinkTcpConfig::TCP_PORT_DEFAULT);
            udpConf.setHostAddress(conf.getHostAddress());
            pCli->setLinkTcpConfig(&conf);
            pUdp->setLinkUdpConfig(&udpConf);
            pUdp->setReceptionServer(m_pUdpServer);
            m_lDiscoverLinkTcp.append(pCli);
            m_lDiscoverLinkTcp.append(pUdp);
            tryConnectTcpCli(pCli);
            tryConnectUdpCli(pUdp);
        }
        {
            // Internal socket (simu)
            ComLinkTcpCli* pCli = new ComLinkTcpCli(m_pIntComMsg);
            ComLinkTcpConfig conf;
            conf.setHostAddress("127.0.0.1");
            conf.setPortNumber(ComLinkTcpConfig::TCP_PORT_DEFAULT+i);
            pCli->setLinkTcpConfig(&conf);
            m_lDiscoverLinkTcp.append(pCli);
            tryConnectTcpCli(pCli);
        }
    }

    // start timer
    if( ! m_tDiscoverSerial->isActive() ) {
        onRetryDiscoverSerial();
        m_tDiscoverSerial->start(DISCOVER_INTERVAL_MS);
    }
}

void ComLinkManager::stopDiscover()
{
    // stop timer
    if( m_tDiscoverSerial->isActive() ) {
        m_tDiscoverSerial->stop();
    }
}

bool ComLinkManager::isAnyLinkReconnecting()
{
   for(const GenComLink* link : m_lDiscoverLinkTcp) {
      if(link->hasBeenConnected() && (!link->isAuthentified())) {
         return true;
      }
   }
   return false;
}

void ComLinkManager::deleteLinks()
{    
    stopTcpServer();
    m_pComLinkModel->resetModel();
    // delete items of m_lLinkConnected
    for(auto i : qAsConst(m_lLink)) {
        if(i->isConnected()) {
            i->stopConnection();
        }
        i->deleteLink();
        i->deleteLater();
    }
    m_lLink.clear();
    m_lDiscoverLinkSerial.clear();
}

void ComLinkManager::deleteLink(GenComLink* p_link)
{
    if( !m_lDiscoverLinkTcp.contains(p_link) && m_pComLinkTcpServer != p_link) {
        // delete items of m_lLinkConnected
        QList<GenComLink *> itemToRemove;
        int iRow = 0;
        for(auto i : qAsConst(m_lLink)) {
            if( p_link == i ) {
                if(i->isConnected()) {
                    i->stopConnection();
                }
                i->deleteLink();
                i->deleteLater();
                m_pComLinkModel->removeLink(iRow-itemToRemove.size()); // list of the model takes care of removed items, iRow not
                itemToRemove.append(i);
            }
            iRow++;
        }

        for(auto i : qAsConst(itemToRemove)) {
            m_lLink.removeAll(i);
            if( m_lDiscoverLinkSerial.contains((ComLinkSerial*)i) ) {
                m_lDiscoverLinkSerial.removeAll((ComLinkSerial*)i);
            }
        }
    }
}

void ComLinkManager::keepLinks(const QList<GenComLink *> &p_lLinks)
{
    // delete items of m_lLinkConnected
    QList<GenComLink *> itemToRemove;
    int iRow = 0;
    for(auto i : qAsConst(m_lLink)) {
        if( !p_lLinks.contains(i) ) {
            if(i->isConnected()) {
                i->stopConnection();
            }
            i->deleteLink();
            i->deleteLater();
            m_pComLinkModel->removeLink(iRow-itemToRemove.size()); // list of the model takes care of removed items, iRow not
            itemToRemove.append(i);
        }
        iRow++;
    }

    for(auto i : qAsConst(itemToRemove)) {
        m_lLink.removeAll(i);
    }
}


