QAbstractListModel *ComLinkManager::getLinkModel() const
{
    return m_pComLinkModel;
}

void ComLinkManager::disconnectLink(const QString &p_linkName)
{
    GenComLink * l = findLinkFromName(p_linkName);
    if( nullptr != l ) {
        //if( l->isConnected() ) {
            l->stopConnection();
        //}
    }
}

void ComLinkManager::setComPort(const QString &p_linkName, QString p_portName)
{
    GenComLink * l = findLinkFromName(p_linkName);
    if( nullptr != l ) {
        ComLinkSerial * s = l->getLinkSerial();
        if( nullptr != s ) {
            quint32 p = 0;
            bool bOk = true;
            if( p_portName == "UNDEF" ) {
                p = 0;
            } else if( p_portName.mid(0,3) =="COM" ) {
                p_portName.remove(0,3);
                p = p_portName.toInt(&bOk);
            }
            if( !bOk ) {
                fLogError(QString("Fail to get port number from string (%1)").arg(p_portName));
            } else {
                s->setConfig(p, ComLinkSerialConfig::SERIAL_BAUDRATE);
            }
        } else {
            fLogError("Link is not a serial port com");
        }
    }
}

QString ComLinkManager::getComPort(const QString &p_linkName)
{
    QString sRet;
    GenComLink * l = findLinkFromName(p_linkName);
    if( nullptr != l ) {
        ComLinkSerial * s = l->getLinkSerial();
        if( nullptr != s ) {
            sRet = "COM"+QString::number(s->getPortNumber());
        }
    }
    return sRet;
}

GenComLink *ComLinkManager::findLinkFromName(const QString &p_linkName)
{
    for(auto i : qAsConst(m_lLink)) {
        if( i->getName() == p_linkName ) {
            return i;
        }
    }
    return nullptr;
}

// -- Inherited XmlSettings behaviour
bool ComLinkManager::customLoadParam(QDomElement * p_pParent)
{
    bool bRet = true;

    QDomElement listLink = XmlHelper::xmlGetChild(p_pParent, "listLink");

    // Load links : parse items
    QDomNode l = listLink.firstChild();
    while(!l.isNull()) {
        QDomElement le = l.toElement();
        if( le.nodeName() == "ComLinkSerial" ) {
            // New link Serial
            ComLinkSerial * pl = new ComLinkSerial(m_pIntComMsg);
            bRet &= pl->loadSettings(&le);
            addLink(pl);

        }
        l = l.nextSiblingElement();
    }
    bRet &= XML_READ_UNIQUE_DEFAULT(QString, m_tcpDiscoverIpBase, "192.168.0.");
    return bRet;
}

bool ComLinkManager::customLoadDefaultParam()
{
    bool bRet = true;
    m_tcpDiscoverIpBase = ComLinkTcpConfig::TCP_BASE_IP;
    return bRet;
}

bool ComLinkManager::customApplyParam()
{
    bool bRet = true;        

    return bRet;
}

bool ComLinkManager::customSaveParam(QDomDocument * p_pDoc, QDomElement * p_pParent)
{
    bool bRet = true;
    QDomElement oldTagListLink = XmlHelper::xmlAddUniqueChild(p_pDoc, p_pParent, "listLink");
    QDomElement listLink = p_pDoc->createElement("listLink");
    p_pParent->replaceChild(listLink,oldTagListLink);

    // Make one node by link
    for(auto i : qAsConst(m_lLink)) {
        QDomElement lTag = XmlHelper::xmlAddChild(p_pDoc, &listLink, i->getXmlSettingsName());
        bRet &= i->saveSettings(&lTag);
    }

    //bRet &= m_pComLinkTcpServer->saveSettings(p_pParent);

    bRet &= XML_WRITE_UNIQUE(m_tcpDiscoverIpBase);

    return bRet;
}

bool ComLinkManager::tryConnectTcpCli(ComLinkTcpCli* p_pCli)
{
    addLink(p_pCli);
    p_pCli->startConnection();
    return true;
}

bool ComLinkManager::tryConnectUdpCli(ComLinkUdpCli *p_pCli)
{
    addLink(p_pCli);
    p_pCli->startConnection();
    return true;
}

// -- Link
void ComLinkManager::addLink(GenComLink * p_link)
{    
    connect(p_link, &GenComLink::evLinkStateChanged, this, &ComLinkManager::onLinkStateChanged);
    m_lLink.append(p_link);
    emit evNewLink(p_link);
    m_pComLinkModel->addLink();
    m_pComLinkModel->updateLinks();
}

GenComLink *ComLinkManager::getLinkName(const QString p_name) const
{
    for(auto i : qAsConst(m_lLink)) {
        if( i->getName() == p_name ) {
            return i;
        }
    }
    return nullptr;
}


void ComLinkManager::onLinkStateChanged(GenComLink* p_link, quint32 p_old, qint32 p_new)
{
    if( GenComLink::LINK_STATE_AUTHENTIFIED == p_new ) {
        emit evNewLinkAuthentified(p_link);
    } else if( !p_link->isConnected() &&
               (GenComLink::LINK_STATE_AUTHENTIFIED == p_old || GenComLink::LINK_STATE_CONNECTED == p_old )) {
        emit evLinkDisconnected(p_link);
    }
    m_pComLinkModel->updateLinks();
}

void ComLinkManager::onRefreshComPortList()
{
    // first, get list of current ports :
    QStringList lAvailablePorts;
    bool bOk;
    foreach (const QSerialPortInfo &Port, QSerialPortInfo::availablePorts() )
    {
        quint32 serialNum = Port.portName().midRef(3).toInt(&bOk);
        if( bOk ) {
            lAvailablePorts.append("COM"+QString::number(serialNum));
        }
    }

    if( lAvailablePorts != m_comPortList ) {
        m_comPortList = lAvailablePorts;
        emit comPortListChanged();
        m_pComLinkModel->updateLinks();
    }
}

void ComLinkManager::onIntComMsgDeviceAdChanged(qint32 /*p_deviceAd*/)
{

}

void ComLinkManager::onRetryDiscoverSerial()
{
    // Try to open all Serial Port Com not opened :

    // first, get list of current ports :
    QStringList lAvailablePorts;
    bool bOk;
    foreach (const QSerialPortInfo &Port, QSerialPortInfo::availablePorts() )
    {
        quint32 serialNum = Port.portName().midRef(3).toInt(&bOk);
        if( bOk ) {
            bool bFound = false;
            for(auto i : qAsConst(m_lDiscoverLinkSerial) ) {
                if( i->getPortNumber() == serialNum ) {
                    bFound = true;
                    break;
                }
            }
            if( !bFound ) {
                // make serial
                ComLinkSerial * pSerial = new ComLinkSerial(m_pIntComMsg);
                pSerial->setName(QString("COM%1").arg(serialNum));
                pSerial->setConfig(serialNum, ComLinkSerialConfig::SERIAL_BAUDRATE);
                m_lDiscoverLinkSerial.append(pSerial);
                addLink(pSerial);
            }
        }
    }
}


