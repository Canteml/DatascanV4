// -- Qt include
#include <QSerialPortInfo>

ComLinkManager::ComLinkManager(IntComMsg *p_pIntComMsg) : QObject(p_pIntComMsg), Loggable("ComLinkManager"), XmlProject("ComLinkManager")
{
    m_pIntComMsg = p_pIntComMsg;
    m_discoverDevice = false;
    m_pComLinkTcpServer = nullptr;

    // make timers
    m_tRefreshProtCom = new QTimer();
    connect(m_tRefreshProtCom, &QTimer::timeout, this, &ComLinkManager::onRefreshComPortList);

    m_tDiscoverSerial = new QTimer();
    m_tDiscoverSerial->setSingleShot(false);
    connect(m_tDiscoverSerial, &QTimer::timeout, this, &ComLinkManager::onRetryDiscoverSerial);

    // TCP Cli
    m_tcpDiscoverIpBase = ComLinkTcpConfig::TCP_BASE_IP;

    connect(m_pIntComMsg, &IntComMsg::deviceAdChanged, this, &ComLinkManager::onIntComMsgDeviceAdChanged);

    // init MPC/Device configuration
    onIntComMsgDeviceAdChanged(m_pIntComMsg->getDeviceAd());

    m_pComLinkModel = new ComLinkModel(this, &m_lLink);


    // Force first resresh
    onRefreshComPortList();

    // start timer
    m_tRefreshProtCom->start(500);

    m_pUdpServer = new ComLinkUdpServer();
    startUdpServer();
}

ComLinkManager::~ComLinkManager()
{    
    stopDiscover();
    if( m_tDiscoverSerial->isActive() ) {
        m_tDiscoverSerial->stop();
    }

    m_tRefreshProtCom->stop();
    delete m_tRefreshProtCom;
    m_tRefreshProtCom = nullptr;
    //m_pMyInstance = nullptr;
    deleteLinks();
    delete m_pComLinkModel;
    m_pComLinkModel = nullptr;
    delete m_pUdpServer;
    m_pUdpServer = nullptr;
}

// -- Direct link instantiation
// Serial Link
GenComLink * ComLinkManager::addSerial(quint32 p_port, quint32 p_bauds, const QString & p_name)
{
    // make serial
    ComLinkSerial * pSerial = new ComLinkSerial(m_pIntComMsg);
    pSerial->setName(p_name);
    pSerial->setConfig(p_port, p_bauds); // start connection
    addLink(pSerial);

    return pSerial;
}

