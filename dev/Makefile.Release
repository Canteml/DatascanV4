QMAKE_TARGET  = DatascanV2
DESTDIR        = build\release\ #avoid trailing-slash linebreak
TARGET         = DatascanV2.exe
DESTDIR_TARGET = build\release\DatascanV2.exe

####### Build rules

first: all
all: Makefile.Release  build/release/DatascanV2.exe

build/release/DatascanV2.exe: C:/Qt/5.15.2/mingw81_32/lib/libQt5Quick.a C:/Qt/5.15.2/mingw81_32/lib/libQt5PrintSupport.a C:/Qt/5.15.2/mingw81_32/lib/libQt5OpenGL.a C:/Qt/5.15.2/mingw81_32/lib/libQt5Widgets.a C:/Qt/5.15.2/mingw81_32/lib/libQt5Multimedia.a C:/Qt/5.15.2/mingw81_32/lib/libQt5Gui.a C:/Qt/5.15.2/mingw81_32/lib/libQt5QmlModels.a C:/Qt/5.15.2/mingw81_32/lib/libQt5Qml.a C:/Qt/5.15.2/mingw81_32/lib/libQt5Network.a C:/Qt/5.15.2/mingw81_32/lib/libQt5SerialPort.a C:/Qt/5.15.2/mingw81_32/lib/libQt5Xml.a C:/Qt/5.15.2/mingw81_32/lib/libQt5Core.a C:/Qt/5.15.2/mingw81_32/lib/libqtmain.a build/res build/release/SDL2.dll datascanv2_metatypes.json build/release/.ui/ui_WinLog.h $(OBJECTS) build/release/.obj/DatascanV2_resource_res.o
	$(LINKER) $(LFLAGS) -o $(DESTDIR_TARGET) @object_script.DatascanV2.Release  $(LIBS)

build/release/.obj/DatascanV2_resource_res.o: DatascanV2_resource.rc
	windres -i DatascanV2_resource.rc -o build\release\.obj\DatascanV2_resource_res.o --include-dir=. $(DEFINES)

qmake: FORCE
	@$(QMAKE) -o Makefile.Release DatascanV2.pro -spec win32-g++ "CONFIG+=qtquickcompiler"

qmake_all: FORCE

